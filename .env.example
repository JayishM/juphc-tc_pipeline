# Tax Calculator - Environment Configuration Example
# Copy this file to .env and customize as needed. Never commit .env with real credentials.

# Application Server Configuration
PORT=3000
NODE_ENV=production

# IBM Cloud Account & Container Registry Placeholders
IBM_CLOUD_API_KEY=<YOUR_IBM_CLOUD_API_KEY>
IBM_CLOUD_REGION=us-south
IBM_CLOUD_RESOURCE_GROUP=default
ICR_NAMESPACE=<YOUR_ICR_NAMESPACE>
ICR_REGISTRY_HOST=us.icr.io
IMAGE_NAME=tax-calculator
IMAGE_TAG=latest

# IBM Cloud Code Engine Deployment Placeholders
CE_PROJECT_NAME=tax-calculator-project
CE_APP_NAME=tax-calculator
